// Index for fast lookup
const ACTIONS_INDEX = {};
for (const a of ACTIONS) {
  if (!ACTIONS_INDEX[a[0]]) ACTIONS_INDEX[a[0]] = {};
  ACTIONS_INDEX[a[0]][a[1]] = a;
}

function getAction(sid, aid) {
  return (ACTIONS_INDEX[sid] || {})[aid] || null;
}

module.exports = { ACTIONS, ACTIONS_INDEX, getAction };
